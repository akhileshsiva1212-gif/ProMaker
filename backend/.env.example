# LLM Configuration (required for reasoning)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Optional: Real Hindsight Cloud or self-hosted
# If set, ProMaker will use real Hindsight instead of local memory
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=promaker-product

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173